{
  "name": "deepseek-harness-code",
  "version": "0.1.0-BETA5",
  "private": true,
  "description": "Community DeepSeek Harness coding desktop with integrated plugins",
  "license": "MIT",
  "author": {
    "name": "DeepSeek Harness Code Contributors",
    "email": "maintainers@deepseek-harness.code"
  },
  "packageManager": "pnpm@11.19.0",
  "main": "dist/desktop/main.js",
  "scripts": {
    "build": "pnpm clean && pnpm build:icon && pnpm build:harness && pnpm build:node-runtime && pnpm build:routing-suite && pnpm build:desktop && pnpm build:watchdog && pnpm build:plugin && pnpm build:anchored-plugin && pnpm build:sidebar",
    "build:icon": "node scripts/build-icon.mjs",
    "build:harness": "node scripts/build-harness.mjs",
    "build:node-runtime": "node scripts/prepare-node-runtime.mjs",
    "build:desktop": "tsup --config tsup.desktop.config.ts",
    "build:watchdog": "tsup packages/watchdog/src/entry.ts --format cjs --platform node --target node24 --out-dir dist/watchdog --sourcemap",
    "build:plugin": "pnpm --dir packages/desktop-plugin run build",
    "build:anchored-plugin": "pnpm --dir packages/anchored-standard-plugin run build",
    "build:sidebar": "pnpm --dir packages/better-sidebar run build",
    "clean": "rimraf dist release build/node-runtime",
    "test": "pnpm test:unit && pnpm test:anchored && pnpm test:plugin && pnpm test:package && pnpm test:e2e",
    "test:unit": "vitest run tests/unit packages/desktop-plugin/test packages/watchdog/test packages/prompt-principles-plugin/test",
    "test:anchored": "pnpm --dir packages/anchored-standard-plugin test",
    "test:plugin": "vitest run --config tests/e2e/plugin-vitest.config.ts",
    "test:package": "pnpm build:icon && vitest run --config tests/e2e/package-vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && node scripts/check-doc-links.mjs && node scripts/check-security-contract.mjs",
    "check:memory": "node scripts/check-memory-bounds.mjs",
    "preflight:runtime": "node scripts/check-runtime-closure.mjs --release",
    "smoke:package": "node scripts/smoke-packaged-runtime.mjs",
    "start": "pnpm build && electron .",
    "pack:dir": "pnpm build && pnpm preflight:runtime && electron-builder --mac --dir --universal",
    "dist:mac": "pnpm build && pnpm preflight:runtime && electron-builder --mac --universal",
    "dist:mac:split": "pnpm build && pnpm preflight:runtime && electron-builder --mac --x64 --arm64",
    "dist:win": "pnpm build && pnpm preflight:runtime && electron-builder --win --x64 --arm64",
    "dist:linux": "pnpm build && pnpm preflight:runtime && electron-builder --linux --x64 --arm64",
    "verify:mac": "node scripts/verify-macos-artifact.mjs",
    "verify:docs": "node scripts/check-doc-links.mjs",
    "verify:security": "node scripts/check-security-contract.mjs",
    "build:routing-suite": "node scripts/fetch-routing-suite.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "link:deps/deepseek-harness/apps/cli",
    "@deepseek-ai/dsh-anonymous-user-id": "link:deps/deepseek-harness/packages/identity/anonymous-user-id",
    "@deepseek-ai/dsh-atomic-write": "link:deps/deepseek-harness/packages/util/atomic-write",
    "@deepseek-ai/dsh-bash-local": "link:deps/deepseek-harness/packages/shell/bash-local",
    "@deepseek-ai/dsh-client-ui-primitives": "link:deps/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-code-runtime": "link:deps/deepseek-harness/packages/code-runtime/code-runtime",
    "@deepseek-ai/dsh-compaction": "link:deps/deepseek-harness/packages/compaction/compaction",
    "@deepseek-ai/dsh-fs": "link:deps/deepseek-harness/packages/fs/fs",
    "@deepseek-ai/dsh-home-paths": "link:deps/deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-invariants": "link:deps/deepseek-harness/packages/runtime-diagnostics/invariants",
    "@deepseek-ai/dsh-output-retention": "link:deps/deepseek-harness/packages/util/output-retention",
    "@deepseek-ai/dsh-sandbox": "link:deps/deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-scope": "link:deps/deepseek-harness/packages/core/scope",
    "@deepseek-ai/dsh-session-telemetry": "link:deps/deepseek-harness/packages/session/session-telemetry",
    "@deepseek-ai/dsh-session-title-llm": "link:deps/deepseek-harness/packages/session/session-title-llm",
    "@deepseek-ai/dsh-shell": "link:deps/deepseek-harness/packages/shell/shell",
    "@deepseek-ai/dsh-spill": "link:deps/deepseek-harness/packages/spill/spill",
    "@deepseek-ai/dsh-subagent-in-process-driver": "link:deps/deepseek-harness/packages/subagent/subagent-in-process-driver",
    "@deepseek-ai/dsh-subprocess": "link:deps/deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-timeout": "link:deps/deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tools": "link:deps/deepseek-harness/packages/core/tools",
    "@deepseek-ai/dsh-workflow": "link:deps/deepseek-harness/packages/workflow/workflow",
    "@hono/node-server": "2.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "cross-spawn": "7.0.6",
    "debug": "4.4.3",
    "deepseek-harness-desktop-plugin": "workspace:*",
    "dsh-find-plugin": "0.3.6",
    "eventsource": "3.0.7",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "pnpm": "11.19.0",
    "raw-body": "3.0.2",
    "zod": "4.1.5"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-arm64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-arm64": "0.35.3",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-arm64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.5",
    "@koromix/koffi-darwin-x64": "3.1.5",
    "@koromix/koffi-linux-arm64": "3.1.5",
    "@koromix/koffi-linux-x64": "3.1.5",
    "@koromix/koffi-win32-arm64": "3.1.5",
    "@koromix/koffi-win32-x64": "3.1.5",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-arm64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-darwin-arm64": "0.1.4",
    "node-addon-require-builtin-darwin-x64": "0.1.4",
    "node-addon-require-builtin-linux-arm64-gnu": "0.1.4",
    "node-addon-require-builtin-linux-x64-gnu": "0.1.4",
    "node-addon-require-builtin-win32-arm64-msvc": "0.1.4",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.34.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "sharp": "0.35.3",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
