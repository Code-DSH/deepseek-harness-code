{
  "name": "deepseek-harness-code",
  "version": "0.3.2",
  "private": true,
  "description": "Community DeepSeek Harness coding desktop with integrated plugins",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "main": "dist/desktop/main.js",
  "scripts": {
    "build": "pnpm clean && pnpm build:routing-suite && pnpm build:desktop && pnpm build:watchdog && pnpm build:plugin && pnpm build:anchored-plugin",
    "build:icon": "node scripts/build-icon.mjs",
    "build:desktop": "tsup --config tsup.desktop.config.ts",
    "build:watchdog": "tsup packages/watchdog/src/entry.ts --format cjs --platform node --target node24 --out-dir dist/watchdog --sourcemap",
    "build:plugin": "pnpm --dir packages/desktop-plugin run build",
    "build:anchored-plugin": "pnpm --dir packages/anchored-standard-plugin run build",
    "clean": "rimraf dist release",
    "test": "pnpm test:unit && pnpm test:anchored && pnpm test:plugin && pnpm test:package && pnpm test:e2e",
    "test:unit": "vitest run tests/unit packages/desktop-plugin/test packages/watchdog/test",
    "test:anchored": "pnpm --dir packages/anchored-standard-plugin test",
    "test:plugin": "vitest run --config tests/e2e/plugin-vitest.config.ts",
    "test:package": "vitest run --config tests/e2e/package-vitest.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "preflight:runtime": "node scripts/check-runtime-closure.mjs",
    "start": "pnpm build && electron .",
    "pack:dir": "pnpm build && pnpm build:icon && pnpm preflight:runtime && electron-builder --mac --dir --universal",
    "dist:mac": "pnpm build && pnpm build:icon && pnpm preflight:runtime && electron-builder --mac --universal",
    "dist:mac:split": "pnpm build && pnpm build:icon && pnpm preflight:runtime && electron-builder --mac --x64 --arm64",
    "dist:win": "pnpm build && pnpm build:icon && pnpm preflight:runtime && electron-builder --win --x64 --arm64",
    "dist:linux": "pnpm build && pnpm build:icon && pnpm preflight:runtime && electron-builder --linux --x64 --arm64",
    "verify:mac": "node scripts/verify-macos-artifact.mjs",
    "verify:docs": "node scripts/check-doc-links.mjs",
    "verify:security": "node scripts/check-security-contract.mjs",
    "build:routing-suite": "node scripts/fetch-routing-suite.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@hono/node-server": "2.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cors": "2.8.6",
    "cross-spawn": "7.0.6",
    "debug": "4.4.3",
    "deepseek-harness-desktop-plugin": "workspace:*",
    "eventsource": "3.0.7",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "raw-body": "3.0.2",
    "zod": "4.1.5"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-linux-arm64": "1.3.2",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-linux-arm64": "0.35.3",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-arm64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3",
    "@koromix/koffi-darwin-arm64": "3.1.5",
    "@koromix/koffi-darwin-x64": "3.1.5",
    "@koromix/koffi-linux-arm64": "3.1.5",
    "@koromix/koffi-linux-x64": "3.1.5",
    "@koromix/koffi-win32-arm64": "3.1.5",
    "@koromix/koffi-win32-x64": "3.1.5",
    "@vscode/ripgrep-darwin-arm64": "1.18.0",
    "@vscode/ripgrep-darwin-x64": "1.18.0",
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-arm64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0",
    "node-addon-require-builtin-darwin-arm64": "0.1.4",
    "node-addon-require-builtin-darwin-x64": "0.1.4",
    "node-addon-require-builtin-linux-arm64-gnu": "0.1.4",
    "node-addon-require-builtin-linux-x64-gnu": "0.1.4",
    "node-addon-require-builtin-win32-arm64-msvc": "0.1.4",
    "node-addon-require-builtin-win32-x64-msvc": "0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.55.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "8.41.0",
    "@typescript-eslint/parser": "8.41.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "9.34.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
