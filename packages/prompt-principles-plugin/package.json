{
  "name": "dsh-prompt-principles",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental layered prompt-principles injection for DeepSeek Harness: appends well-ordered behavioral sections to the system prompt of Standard-like modes, with an official Settings toggle that is on by default",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2.code.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2.code.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2.code.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2.code.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2.code.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2.code.1",
    "react": "^18.2.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsup src/index.ts --format esm --platform node --target node24 --out-dir . --dts",
    "build:client": "node ./scripts/build-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@deepseek-ai/dsh-client-connection": "link:../../deps/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../deps/deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-runtime": "link:../../deps/deepseek-harness/packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../deps/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../deps/deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deps/deepseek-harness/packages/client/ui-slots",
    "esbuild": "0.25.12"
  }
}
