{
  "name": "dsh-anchored-standard",
  "version": "0.1.0",
  "private": true,
  "description": "Fail-closed Standard fallback for experimental anchored mode",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --platform node --target node24 --out-dir . --dts"
  }
}
