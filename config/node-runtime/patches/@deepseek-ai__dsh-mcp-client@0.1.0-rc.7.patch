diff --git a/lib/index.js b/lib/index.js
index 5f09b3f7a3ffcf1e40f1e35fcd7e2a2f8c6a0e29..8e2e7e7f1d3a7a2a0a4e5b6c7d8e9f0a1b2c3d4e 100644
--- a/lib/index.js
+++ b/lib/index.js
@@ -603,7 +603,19 @@ async function apply(ctx, config) {
 	ctx.effect(() => {
 		return () => connection.dispose();
 	}, "mcp-client.connection");
-	const outcome = await connection.ready;
-	if (outcome.error !== void 0 && config.failOnStartupError) throw new Error(`mcp-client(${config.serverName}): initial connection or tool synchronization failed`, { cause: outcome.error });
+	if (config.failOnStartupError) {
+		const outcome = await connection.ready;
+		if (outcome.error !== void 0) throw new Error(`mcp-client(${config.serverName}): initial connection or tool synchronization failed`, { cause: outcome.error });
+	} else {
+		// Never stall the plugin tree on the first MCP connection: a slow or
+		// half-open network would otherwise keep the whole profile from
+		// loading. Connect in the background and let the reconnect policy
+		// handle failures.
+		connection.ready.then((outcome) => {
+			if (outcome.error !== void 0) process.stderr.write(`[mcp-client] ${config.serverName}: initial connection failed, retrying per reconnect policy: ${String(outcome.error?.message ?? outcome.error)}\n`);
+		}).catch((error) => {
+			process.stderr.write(`[mcp-client] ${config.serverName}: background connection error: ${String(error?.message ?? error)}\n`);
+		});
+	}
 }
